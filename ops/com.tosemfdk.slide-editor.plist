<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.tosemfdk.slide-editor</string>

  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>/Users/loe/workspace/github/tosemfdk/tools/slide-editor-server.mjs</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/loe/workspace/github/tosemfdk</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>SLIDE_EDITOR_TOKEN_FILE</key>
    <string>/Users/loe/.config/tosemfdk/slide-editor-token</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>

  <key>ProcessType</key>
  <string>Background</string>

  <key>ThrottleInterval</key>
  <integer>5</integer>

  <key>StandardOutPath</key>
  <string>/Users/loe/Library/Logs/tosemfdk/slide-editor.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/loe/Library/Logs/tosemfdk/slide-editor-error.log</string>
</dict>
</plist>
